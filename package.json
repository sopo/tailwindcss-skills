    "playwright": "1.64.1",
    "promptfoo": "0.125.1",
    "tailwind-node-minimum": "npm:@tailwindcss/node@4.1.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-minimum": "npm:tailwindcss@4.1.0",
    "vite": "8.3.5",
    "vue": "3.5.44"
